{
  "name": "unidad3-cloud-native-microservice",
  "version": "1.0.0",
  "description": "Microservicio Cloud-Native con Observabilidad (Metricas, Logs JSON, Trazas), Seguridad DevSecOps (JWT, Zero Trust) y Resiliencia (Circuit Breaker, Rate Limit, Retry) para Kubernetes (Minikube), Terraform y GitHub Actions CI/CD.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles",
    "lint:types": "tsc --noEmit"
  },
  "keywords": [
    "cloud-native",
    "microservices",
    "kubernetes",
    "minikube",
    "docker",
    "terraform",
    "ci-cd",
    "devsecops",
    "observability",
    "resilience"
  ],
  "author": "Camilo Alexander Vargas Quintero",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.2"
  }
}
